# 复制为 .env 后填入真实值

# 对话模型
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini

# 兼容 OpenAI 协议的网关地址（可选），例如自建代理
# OPENAI_BASE_URL=https://api.openai.com/v1

# 向量模型（第 4 周 RAG 使用）
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 若网关不支持 embedding 模型，可设为 true 使用本地哈希向量（降级方案）
USE_LOCAL_EMBEDDING=false

# 服务端口
PORT=3000

# ---------- 第 6 周：MCP ----------

# MCP 写操作令牌（stdio 模式下由 Client 通过 env 注入）
MCP_AUTH_TOKEN=demo-token

# HTTP 传输的 MCP Server 端口与端点
MCP_HTTP_PORT=3100
# MCP_HTTP_ENDPOINT=http://127.0.0.1:3100/mcp

# 设为 1 时，天气 MCP Server 会定时推送资源更新通知（用于演示资源订阅）
# MCP_RESOURCE_TICK=1

# ---------- 第 7 周：评估 ----------

# 回归评测只跑前 N 条用例，留空表示全量
# EVAL_LIMIT=8

# ---------- 第 8 周：服务化 ----------

# 配置后开启接口鉴权（Authorization: Bearer <token>，SSE 用 ?token=）；留空为开发模式
# API_TOKEN=demo-api-token

# 每 IP 每分钟的请求上限
RATE_LIMIT_PER_MINUTE=120

